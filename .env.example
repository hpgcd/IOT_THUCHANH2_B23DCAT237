# Sao chep thanh .env neu muon doi cau hinh. Khong dua token that len Git.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MOSQUITTO_PORT=1883
MQTT_TOPIC=iot/B23DCAT237/esp32/pir/telemetry
INFLUX_URL=http://localhost:8086
INFLUX_ORG=ptit
INFLUX_BUCKET=iot_sensor_data
INFLUX_TOKEN=local-dev-token-change-me
DATA_DIR=data

# Docker Compose (chi dung cho moi truong thuc hanh cuc bo)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=admin12345
GRAFANA_ADMIN_PASSWORD=admin12345
